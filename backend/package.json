{
  "name": "scorcher-build-backend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Scorcher Build backend: a Cloudflare Worker (separate from the race's Worker) with a Durable Object per trial, D1, R2 and a model proxy.",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --test --test-reporter=spec test/*.test.ts",
    "dev": "node scripts/build-public.mjs && wrangler dev",
    "bundle": "node scripts/build-public.mjs && wrangler deploy --dry-run --outdir .bundle",
    "deploy": "node scripts/build-public.mjs && wrangler deploy",
    "smoke": "node scripts/smoke.mjs",
    "migrate:local": "wrangler d1 migrations apply scorcher-build --local",
    "migrate": "wrangler d1 migrations apply scorcher-build --remote",
    "build:public": "node scripts/build-public.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.5.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261104.1",
    "typescript": "^6.0.0",
    "wrangler": "^4.158.0",
    "@types/node": "^22.0.0"
  }
}
